{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      },
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/how-it-works/index.html",
        "http://localhost/ghost-jobs/index.html",
        "http://localhost/open-source/index.html",
        "http://localhost/pricing/index.html",
        "http://localhost/rights/index.html",
        "http://localhost/privacy/index.html",
        "http://localhost/terms/index.html",
        "http://localhost/about/index.html",
        "http://localhost/attribution/index.html",
        "http://localhost/accessibility/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 150
          }
        ],
        "unused-javascript": [
          "warn",
          {
            "maxNumericValue": 20000
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
