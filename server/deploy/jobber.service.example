# Example systemd unit, /etc/systemd/system/jobber.service. Adjust paths and user.
# Secrets live in /etc/jobber/env (mode 0600, owner root): TURNSTILE_SECRET, JOBBER_HASH_SECRET, OPENROUTER_API_KEY, the JOBBER_* settings.
[Unit]
Description=Jobber hosted API
After=network-online.target
Wants=network-online.target

[Service]
User=jobber
WorkingDirectory=/opt/jobber
EnvironmentFile=/etc/jobber/env
Environment=NODE_ENV=production JOBBER_TRUST_PROXY=1
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=3

# Hardening. PrivateTmp gives the service its own /tmp (Chromium profiles included), emptied when it stops,
# so a crash cannot leave visitor data in a shared temp directory.
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/jobber/server/data
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
# Chromium needs a few hundred MB per render. Size to the VPS; this stops one runaway render taking the host down.
MemoryMax=1500M
TasksMax=512

[Install]
WantedBy=multi-user.target
